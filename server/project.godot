; Headless PONG online server project.
; The server keeps room state in memory and accepts WebSocket clients.
config_version=5

[application]
config/name="PONG Online Server"
run/main_scene="res://server_main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1
window/size/viewport_height=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
