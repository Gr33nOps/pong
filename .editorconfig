root = true

[*]
charset = utf-8

[*.gd]
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.tscn]
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.godot]
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true