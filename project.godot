; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Paddle Polygon"
config/version="1.3.3"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/art/logo.png"
config/icon="res://assets/art/icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Sound="*res://scripts/autoload/sound.gd"
InkEffects="*res://scripts/autoload/ink_effects.gd"
InkFont="*res://scripts/autoload/ink_font.gd"
Network="*res://scripts/autoload/network.gd"

[display]

window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(1, 1, 1, 1)
